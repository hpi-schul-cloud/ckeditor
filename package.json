{
	"name": "@hpi-schul-cloud/ckeditor",
	"version": "3.0.2",
	"description": "Custom version of CKEditor5 for the Schulcloud-Verbund-Software-Client",
	"author": "Dataport Schulcloud-Verbund-Software Team",
	"repository": {
		"url": "https://github.com/hpi-schul-cloud/ckeditor"
	},
	"license": "AGPL-3.0",
	"homepage": "https://github.com/hpi-schul-cloud/ckeditor",
	"type": "module",
	"main": "./build/index.js",
	"types": "./build/index.d.ts",
	"exports": {
		".": {
			"types": "./build/index.d.ts",
			"import": "./build/index.js"
		},
		"./legacy": {
			"types": "./build/legacy.d.ts",
			"import": "./build/legacy.js"
		},
		"./build/style.css": "./build/style.css",
		"./build/style-legacy.css": "./build/style-legacy.css"
	},
	"files": [
		"build"
	],
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": "24",
		"npm": "11"
	},
	"scripts": {
		"build": "vite build && vite build --config vite.config.legacy.ts",
		"dev": "vite build --watch",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"sample": "vite --port 4173 --open /sample/index.html"
	},
	"dependencies": {
		"ckeditor5": "48.3.0"
	},
	"devDependencies": {
		"@types/node": "^26.4.1",
		"@vitest/browser": "^5.0.0",
		"happy-dom": "^20.14.0",
		"jsdom": "^30.0.1",
		"katex": "^0.16.47",
		"prettier": "^3.8.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.0",
		"vite-plugin-dts": "^5.1.0",
		"vitest": "^5.0.0"
	}
}
